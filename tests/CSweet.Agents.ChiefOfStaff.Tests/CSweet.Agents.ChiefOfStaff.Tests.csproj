<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CSweet.Agents.ChiefOfStaff\CSweet.Agents.ChiefOfStaff.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="CSweet.Agent.Testing" Version="5.43.0" Condition="'$(UseLocalCSweetAgentSdk)' != 'true'" />
    <ProjectReference Include="$(CSweetAgentSdkRepositoryRoot)/src/CSweet.Agent.Testing/CSweet.Agent.Testing.csproj" Condition="'$(UseLocalCSweetAgentSdk)' == 'true'" />
  </ItemGroup>
</Project>
